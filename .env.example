# ==============================================================================
# Multi-Satellite Thermal Intelligence Platform - Environment Example Template
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5001

# PostgreSQL + PostGIS Database Connection (Neon / AWS / Self-hosted)
DATABASE_URL="postgresql://username:password@your-database-host.com/neondb?sslmode=require"

# NASA FIRMS API Key (Real-Time NRT VIIRS NOAA-20/21, Suomi-NPP & MODIS Feeds)
NASA_FIRMS_MAP_KEY="your_nasa_firms_map_key_here"


# Geostationary Sensor & Satellite Stream Keys (Optional)
ISRO_MOSDAC_API_KEY=""
AWS_HIMAWARI_BUCKET="s3://noaa-himawari9/"

# Frontend API & WebSocket Live Stream Endpoints
VITE_API_BASE_URL="http://localhost:5001"
VITE_WS_URL="ws://localhost:5001/ws/live-events"

# Map Tiles & External Intelligence URLs
VITE_BASE44_URL="https://thermal-insight-india.base44.app"
VITE_THERMAL_MAP_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
