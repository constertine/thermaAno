{
  "rewrites": [
    {
      "source": "/ml-api/:match*",
      "destination": "https://thermal-anomaly-api.onrender.com/:match*"
    },
    {
      "source": "/ml-api",
      "destination": "https://thermal-anomaly-api.onrender.com/"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
